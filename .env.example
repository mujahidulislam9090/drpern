# ==========================================
# DropEarn Environment Configuration Template
# ==========================================

# 1. Database (PostgreSQL / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dropearn?sslmode=require"

# 2. Storage Provider ("local" for self-hosted/Docker, "cloud" for S3/Cloudflare R2)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./storage/uploads"

# Optional Cloud Storage (Cloudflare R2 / AWS S3 / MinIO)
# S3_BUCKET="dropearn-files"
# S3_REGION="auto"
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# S3_ACCESS_KEY_ID="your-access-key-id"
# S3_SECRET_ACCESS_KEY="your-secret-access-key"

# 3. Firebase Client SDK (Web App Settings)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# 4. Firebase Admin Service Account (Server-Side)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_key_here\n-----END PRIVATE KEY-----\n"

# 5. Monetization & Ads (Optional)
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"
